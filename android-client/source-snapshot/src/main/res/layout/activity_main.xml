<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Main Content (your existing layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_toolbar"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="PC 💻 | 🖥  Audio  Stream 🔊 "
            app:titleTextColor="@color/white"
            android:textAlignment="center"
            app:layout_scrollFlags="scroll|enterAlwaysCollapsed"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- LAN Search Radar Panel -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


        <FrameLayout
            android:id="@+id/lanRadarPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           android:layout_centerInParent="true"
            android:padding="15dp">

            <View
                android:id="@+id/radarRingOuter"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/radar_ring_outer" />

            <View
                android:id="@+id/radarRingMiddle"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/radar_ring_middle" />

            <View
                android:id="@+id/radarRingInner"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/radar_ring_inner" />

            <TextView
                android:id="@+id/radarCenterIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🛜"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/radarCenterImage"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wired_radar"
                android:contentDescription="Wired network"
                android:visibility="gone"
                android:scaleType="centerInside" />
        </FrameLayout>
            <TextView
                android:id="@+id/tvRadarCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginTop="20dp"
                android:text="LAN SEARCH"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_below="@+id/lanRadarPanel"
                android:layout_centerHorizontal="true" />
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:text="Device Name"
            android:textColor="#BBBBBB"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_below="@+id/tvRadarCaption"
            android:layout_centerHorizontal="true" />
        </RelativeLayout>

        <!-- Your existing content here -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Put your existing UI components here -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
          <RelativeLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content">
                <!-- Connection Mode Selector -->
                <RadioGroup
                    android:id="@+id/rdgrpMode"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <!-- Hidden compatibility views. The real Auto/Manual controls now
                         live exclusively on SetupActivity. MainActivity still references
                         these IDs for legacy state/restore paths, so keep them present
                         without rendering them. -->
                    <RadioButton
                        android:id="@+id/rbAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:visibility="gone" />

                    <RadioButton
                        android:id="@+id/rbManual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </RadioGroup>

                <!-- Hidden compatibility fields. Connection setup is performed from
                     SetupActivity, but MainActivity's legacy state/restore code still
                     needs these IDs to remain valid. -->
                <EditText
                    android:id="@+id/etIp"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:inputType="number" />


                  <androidx.appcompat.widget.AppCompatButton android:textAllCaps="false"
                      android:id="@+id/btnClearEndpoint"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:background="@android:color/transparent"
                      android:text="❌"
                      android:textStyle="bold"
                      android:textSize="15sp"
                      android:visibility="gone"/>

              <androidx.appcompat.widget.AppCompatButton
                  android:textAllCaps="false"
                  android:id="@+id/btnMute"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text=" 📱 Mute 🔊"
                  android:textSize="16sp"
                  android:background="@android:color/transparent"
                  android:textStyle="bold"
                  android:layout_toStartOf="@+id/etIp"/>

              <androidx.appcompat.widget.AppCompatButton android:textAllCaps="false"
                  android:id="@+id/btnSync"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="🎚️ BUFFER · MEDIUM · 250ms"
                  android:textStyle="bold"
                  android:layout_margin="8dp"
                  android:layout_marginStart="8dp"
                  android:layout_alignParentEnd="true"
                  android:background="@color/white_transparent"
                  android:textColor="@color/white"
                  />

          </RelativeLayout>
                <!-- Connect/Disconnect Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <androidx.appcompat.widget.AppCompatButton android:textAllCaps="false"
                        android:id="@+id/btnConnect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Connect"
                        android:textStyle="bold"
                        android:backgroundTint="#F9A6F4"/>

                    <androidx.appcompat.widget.AppCompatButton android:textAllCaps="false"
                        android:id="@+id/btnDisconnect"
                        android:text="Disconnect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/red"/>

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/btnConnect"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true">
                <!-- Status -->
                 <TextView
                    android:id="@+id/tvStatus"
                    android:text="Status  💻 ❌ 📱 Disconnected"
                    android:textSize="17sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="@color/white"/>
                <TextView
                    android:id="@+id/tvServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Server Name : Detecting..."
                    android:textSize="18sp"
                    android:textColor="@color/dark_primary"
                    android:textStyle="bold"
                    android:layout_below="@+id/tvStatus"/>

                <TextView
                    android:id="@+id/tvConnectionPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Path: —"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_below="@+id/tvServerInfo"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvStatusHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/design_default_color_error"
                    android:textSize="20sp"
                    android:padding="4dp"
                    android:paddingTop="8dp"
                    android:textAlignment="viewStart"
                    android:text="Connect to the WIFI Audio Server 🖥"
                    android:textStyle="italic|bold"
                    android:layout_below="@+id/tvConnectionPath"/>

                </RelativeLayout>


<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
                <!-- NEW METRICS: Latency, Jitter, Signal -->
                <TextView
                    android:id="@+id/tvLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latency: 0ms"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/background_light"/>
                <TextView
                    android:id="@+id/tvJitter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jitter: 0.0ms"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/background_light"
                    android:layout_below="@+id/tvLatency"/>
                <TextView
                    android:id="@+id/tvSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal: 0dBm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/background_light"
                    android:layout_below="@+id/tvJitter"/>

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_centerVertical="true"
    >


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnScanQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan QR Code">
        <!--display hover text here == Press here to Connect using server  QR Code -->

    </androidx.appcompat.widget.AppCompatButton>

</LinearLayout>
</RelativeLayout>

                <!-- Volume -->
                <TextView
                    android:text=" 🎚️ System Media Volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <SeekBar
                    android:id="@+id/seekVolume"
                    android:max="100"
                    android:progress="60"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>




                <!-- Statistics -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Streaming Statistics"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp" />

                <!-- 🔹 New Packet Counter -->
                <TextView
                    android:id="@+id/tvPackets"
                    android:text="Packets Received - 0 | Dropped - 0"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:textColor="@android:color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white_transparent"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvConnectionQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:padding="12dp"
                    android:text="Quality: Not Connected"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white_transparent"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📈 Live Metrics"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/black_deep"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Latency"
                        android:textSize="12sp"
                        android:textColor="@color/black_deep"/>

                    <ProgressBar
                        android:id="@+id/pbLatency"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jitter"
                        android:textSize="12sp"
                        android:textColor="@color/black_deep"/>

                    <ProgressBar
                        android:id="@+id/pbJitter"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Signal"
                        android:textSize="12sp"
                        android:textColor="@color/black_deep"/>

                    <ProgressBar
                        android:id="@+id/pbSignal"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>


            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
